{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        clj-kondo/clj-kondo {:mvn/version "2025.06.05"}
        com.github.k13labs/clara-rules {:mvn/version "1.5.4"}}
 ;for more examples of aliases see: https://github.com/seancorfield/dot-clojure
 :aliases
 {:repl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                      cider/cider-nrepl {:mvn/version "0.57.0"}}
         :main-opts ["-m" "nrepl.cmdline" "--interactive" "--middleware" "[\"cider.nrepl/cider-middleware\"]"]}}
 :mvn/repos
 {"central" {:url "https://repo1.maven.org/maven2/"}
  "clojars" {:url "https://repo.clojars.org/"}}}
